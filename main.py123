import os
import discord
from discord.ext import commands
from discord import app_commands

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix='!', intents=intents)

@bot.event
async def on_ready():
    print(f'บอท {bot.user.name} ออนไลน์ผ่าน Render เรียบร้อยแล้ว!')
    try:
        synced = await bot.tree.sync()
        print(f"🔄 ซิงค์คำสั่ง Slash Commands สำเร็จทั้งหมด {len(synced)} คำสั่ง")
    except Exception as e:
        print(f"❌ เกิดข้อผิดพลาดในการซิงค์คำสั่ง: {e}")

# คำสั่ง /join
@bot.tree.command(name="join", description="สั่งให้บอทเข้าห้องเสียง VC ที่คุณอยู่")
async def join(interaction: discord.Interaction):
    if interaction.user.voice:
        channel = interaction.user.voice.channel
        await channel.connect()
        await interaction.response.send_message(f"🔊 เข้าห้อง {channel.name} เรียบร้อยแล้วครับ!")
    else:
        await interaction.response.send_message("❌ คุณต้องเข้าห้องเสียง (VC) ก่อนใช้คำสั่งนี้ครับ!", ephemeral=True)

# คำสั่ง /out
@bot.tree.command(name="out", description="สั่งให้บอทออกจากห้องเสียง VC")
async def out(interaction: discord.Interaction):
    if interaction.guild.voice_client:
        await interaction.guild.voice_client.disconnect()
        await interaction.response.send_message("👋 ออกจากห้องเสียงเรียบร้อยแล้ว!")
    else:
        await interaction.response.send_message("❌ บอทไม่ได้อยู่ในห้องเสียงครับ", ephemeral=True)

token = os.environ.get('DISCORD_TOKEN')
bot.run(token)
      
